PORT=5000
HOST=0.0.0.0
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/healthiet
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d

# First-admin bootstrap. Use a strong password; no default credentials ship with the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Healthiet
ADMIN_LAST_NAME=Admin

# Optional SMTP for password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Same-origin production URL, e.g. https://healthiet.onrender.com
FRONTEND_URL=http://localhost:5000

# Optional persistent storage mount for profile photos
UPLOAD_DIR=./uploads
